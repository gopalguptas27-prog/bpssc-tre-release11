      "description": "Student registration, waiting room status, active live exam progress, security violation log, and Admin moderation status keyed by liveExamId_userId.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string" },
        "liveExamId": { "type": "string" },
        "sourceSetId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["REGISTERED", "WAITING_ROOM", "ACTIVE", "SUBMITTED", "FLAGGED", "APPROVED", "DISQUALIFIED"] },
        "answeredCount": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "currentQuestionIndex": { "type": "integer" },
        "savedAnswers": { "type": "object" },
        "violationCount": { "type": "integer" },
        "violationLogs": { "type": "array" },
        "finalFiveMinAlertShown": { "type": "boolean" },
        "score": { "type": "number" },
        "maxMarks": { "type": "number" },
        "adminModerationNote": { "type": "string" },
        "moderatedByUid": { "type": "string" },
        "registeredAtEpochMillis": { "type": "integer" },
        "startedAtEpochMillis": { "type": "integer" },
        "submittedAtEpochMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "groupId", "liveExamId", "sourceSetId", "userId", "userName", "status",
        "answeredCount", "totalQuestions", "violationCount", "violationLogs",
        "createdAt", "updatedAt"
      ]
    },
    "CategoryIconConfig": {
      "title": "CategoryIconConfig",
      "description": "Admin-managed default icon (animated GIF, transparent PNG, JPG, or built-in icon) for one of the 7 official TRE 4.0 test categories.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string" },
        "categoryKey": {
          "type": "string",
          "enum": ["LANGUAGE", "COMMON", "LANGUAGE_COMMON", "MATHEMATICS", "SCIENCE", "FULL_MATHS_SCIENCE", "FULL_MATHS"]
        },
        "iconKey": { "type": "string" },
        "customIconBase64": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "categoryKey", "updatedByUid", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Main Admin role registry."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private User profile, optional WhatsApp contact, and preferences."
    },
    "/inviteCodes/{code}": {
      "schema": { "$ref": "#/entities/InviteCode" },
      "description": "Direct lookup from uppercase invitation code to group."
    },
    "/appUpdates/{updateId}": {
      "schema": { "$ref": "#/entities/AppUpdateRelease" },
      "description": "Admin-managed app update releases readable by signed-in users."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/ExamGroup" },
      "description": "Centralized examination groups."
    },
    "/groups/{groupId}/adminContact/{contactId}": {
      "schema": { "$ref": "#/entities/AdminContact" },
      "description": "Official Admin contact profile for User-to-Admin WhatsApp communication."
    },
    "/groups/{groupId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/GroupMember" },
      "description": "Public group members and live leaderboard scores."
    },
    "/groups/{groupId}/tests/{testId}": {
      "schema": { "$ref": "#/entities/ExamTest" },
      "description": "Admin-created question sets and published exams."
    },
    "/groups/{groupId}/attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/TestAttempt" },
      "description": "Immutable evaluated test attempts keyed by testId_userId."
    },
    "/groups/{groupId}/solutionReattempts/{reattemptId}": {
      "schema": { "$ref": "#/entities/SolutionReattemptRecord" },
      "description": "Isolated solution-mode practice reattempts keyed by testId_userId."
    },
    "/groups/{groupId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/BookmarkedQuestion" },
      "description": "User-bookmarked revision questions."
    },
    "/groups/{groupId}/currentAffairs/{itemId}": {
      "schema": { "$ref": "#/entities/CurrentAffairItem" },
      "description": "Daily Current Affairs image banners."
    },
    "/groups/{groupId}/polls/{pollId}": {
      "schema": { "$ref": "#/entities/QuestionPoll" },
      "description": "Interactive photo question polls and uploaded image solutions."
    },
    "/groups/{groupId}/polls/{pollId}/privateKey/{keyId}": {
      "schema": { "$ref": "#/entities/PollPrivateKey" },
      "description": "Creator-only hidden answer key before poll finalization."
    },
    "/groups/{groupId}/polls/{pollId}/votes/{voterId}": {
      "schema": { "$ref": "#/entities/PollVote" },
      "description": "One-vote-per-user records for interactive polls."
    },
    "/groups/{groupId}/discussions/{commentId}": {
      "schema": { "$ref": "#/entities/DiscussionComment" },
      "description": "Collaborative doubt comments, replies, helpful flags, reports, and correction audit trail."
    },
    "/groups/{groupId}/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/GroupNotification" },
      "description": "Group announcements, exam alerts, and app update notifications."
    },
    "/groups/{groupId}/contentViews/{viewId}": {
      "schema": { "$ref": "#/entities/ContentViewRecord" },
      "description": "Deduplicated unique view logs for Banners and Polls (Admin-only list)."
    },
    "/groups/{groupId}/liveExams/{liveExamId}": {
      "schema": { "$ref": "#/entities/LiveExam" },
      "description": "Scheduled synchronized Live Exams linked to existing question sets."
    },
    "/groups/{groupId}/liveExamSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/LiveExamSession" },
      "description": "Live Exam participant registrations, active progress, security violation logs, and Admin moderation status."
    },
    "/groups/{groupId}/dailyTargets/{targetId}": {
      "schema": { "$ref": "#/entities/DailyTargetTask" },
      "description": "Admin-managed Daily Target Set (Aaj Ka Target) photo banners with IST rollover and next-day scheduling."
    },
    "/groups/{groupId}/categoryIcons/{categoryKey}": {
      "schema": { "$ref": "#/entities/CategoryIconConfig" },
      "description": "Admin-managed default set icons for the 7 official TRE 4.0 categories."
    }
  }
}
